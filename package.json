
{
  "name": "payment_infrastructure",
  "version": "1.0.0",
  "description": "Payment collection infrastructure API built with Node.js, TypeScript, PostgreSQL, Prisma, and Paystack.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:reconciliation": "tsx src/workers/payment-reconciliation.worker-entry.ts",
    "test:unit": "tsx --test tests/payment.service.test.mts tests/payment-confirmation.service.test.mts tests/payment-reconciliation.service.test.mts tests/payment-reconciliation.worker.test.mts",
    "test:integration": "node scripts/run-integration-tests.mjs"
  },
  "keywords": [
    "payment-infrastructure",
    "nodejs",
    "typescript",
    "postgresql",
    "prisma",
    "paystack",
    "payment-api",
    "payment-reconciliation"
  ],
  "author": "Aypaul95",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}