# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/payment_infrastructure"

# JWT signing secret (minimum 32 characters)
JWT_SECRET="replace_with_a_random_secret_at_least_32_characters"

# Paystack
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_test_secret_key"

# Private rider KYC document storage
KYC_STORAGE_DIR="./private_storage/kyc"

# Delivery confirmation
DELIVERY_CONFIRMATION_SECRET="replace_with_a_random_secret_at_least_32_characters"

# Termii SMS
TERMII_API_KEY="replace_with_your_termii_api_key"
TERMII_BASE_URL="replace_with_base_url_from_termii_dashboard"
TERMII_SENDER_ID="replace_with_your_approved_sender_id"

# SMS payload encryption (64 hexadecimal characters)
SMS_ENCRYPTION_KEY="replace_with_64_hexadecimal_characters"

# Rider bank account encryption (64 hexadecimal characters)
BANK_ACCOUNT_ENCRYPTION_KEY="replace_with_64_hexadecimal_characters"
