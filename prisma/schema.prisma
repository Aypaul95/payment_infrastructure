generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessUserRole {
  OWNER
  ADMIN
  STAFF
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// 1. Record the result of each reconciliation attempt.
enum ReconciliationOutcome {
  SUCCESSFUL
  STILL_PENDING
  DETAILS_MISMATCH
  PROVIDER_ERROR
  NOT_FOUND
  NOT_PENDING
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model BusinessAccount {
  id           String   @id @default(cuid())
  businessName String
  email        String   @unique
  phone        String?
  currency     String   @default("NGN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     BusinessUser[]
  customers Customer[]
  payments  Payment[]
  products  Product[]
  orders    Order[]
}

model BusinessUser {
  id                String           @id @default(cuid())
  businessAccountId String
  fullName          String
  email             String           @unique
  passwordHash      String
  role              BusinessUserRole @default(OWNER)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)

  @@index([businessAccountId])
}

model Customer {
  id                String    @id @default(cuid())
  businessAccountId String
  name              String
  email             String?
  phone             String?
  reference         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payments          Payment[]
  orders            Order[]

  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)

  @@unique([businessAccountId, reference])
  @@index([businessAccountId])
}

// 2. Store payment information and its reconciliation schedule.
model Payment {
  id                String        @id @default(cuid())
  businessAccountId String
  customerId        String?
  idempotencyKey    String
  reference         String        @unique
  amount            BigInt
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // 2.1. Track how many reconciliation checks have been attempted.
  reconciliationAttempts Int @default(0)

  // 2.2. Store when the next reconciliation check is due.
  nextReconciliationAt DateTime?

  // 2.3. Temporary lease expiry for a worker processing this payment.
  reconciliationLockedUntil DateTime?

  // 2.4. Store a unique claim token to identify the worker's lease.
  reconciliationLockToken String?

  // 2.5. Link the payment to its reconciliation history.
  reconciliationHistory PaymentReconciliationAttempt[]

  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([businessAccountId, idempotencyKey])
  @@index([businessAccountId])
  @@index([customerId])
  @@index([businessAccountId, status])
  @@index([orderId])
  // 2.6. Find pending payments that are ready for reconciliation.
  @@index([status, nextReconciliationAt])
}

// 3. Keep an audit record for every reconciliation attempt.
model PaymentReconciliationAttempt {
  id        String @id @default(cuid())
  paymentId String

  // 3.1. Record when the attempt started.
  attemptedAt DateTime @default(now())

  // 3.2. Store the reconciliation outcome.
  outcome ReconciliationOutcome

  // 3.3. Store the status reported by Paystack, when available.
  providerStatus String?

  // 3.4. Store a safe error code if the verification request failed.
  errorCode String?

  // 3.5. Link this attempt to the payment.
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, attemptedAt])
  @@index([outcome])
}

model Product {
  id                String   @id @default(cuid())
  businessAccountId String
  name              String
  description       String?
  sku               String
  price             BigInt
  currency          String   @default("NGN")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessAccount    BusinessAccount     @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@unique([businessAccountId, sku])
  @@index([businessAccountId])
  @@index([businessAccountId, isActive])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product          Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservedQuantity Int     @default(0)
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Int
  reason    String?
  createdAt DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type])
}

model Order {
  id                String      @id @default(cuid())
  businessAccountId String
  customerId        String
  orderNumber       String
  idempotencyKey    String
  status            OrderStatus @default(PENDING_PAYMENT)
  subtotal          BigInt
  discount          BigInt      @default(0)
  total             BigInt
  currency          String      @default("NGN")
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]

  @@unique([businessAccountId, orderNumber])
  @@unique([businessAccountId, idempotencyKey])
  @@index([businessAccountId, status])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   BigInt
  subtotal    BigInt
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}
